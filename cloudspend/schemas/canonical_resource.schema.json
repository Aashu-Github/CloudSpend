        },
        "platform": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Platform"
        },
        "architecture": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Architecture"
        },
        "vpc_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vpc Id"
        },
        "private_ip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Private Ip"
        },
        "schedule_eligible": {
          "default": false,
          "title": "Schedule Eligible",
          "type": "boolean"
        }
      },
      "required": [
        "instance_type"
      ],
      "title": "EC2Details",
      "type": "object"
    },
    "MetricSummary": {
      "properties": {
        "namespace": {
          "default": "AWS/EC2",
          "title": "Namespace",
          "type": "string"
        },
        "metric_name": {
          "title": "Metric Name",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "avg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Avg"
        },
        "p95": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P95"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "samples": {
          "default": 0,
          "title": "Samples",
          "type": "integer"
        },
        "missing_ratio": {
          "default": 0.0,
          "title": "Missing Ratio",
          "type": "number"
        },
        "burst_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Burst Score"
        },
        "timestamps": {
          "items": {
            "format": "date-time",
            "type": "string"
          },
          "title": "Timestamps",
          "type": "array"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "metric_name"
      ],
      "title": "MetricSummary",
      "type": "object"
    },
    "SourceLineage": {
      "properties": {
        "provider_mode": {
          "enum": [
            "demo",
            "file",
            "live",
            "canonical",
            "cur"
          ],
          "title": "Provider Mode",
          "type": "string"
        },
        "source_name": {
          "title": "Source Name",
          "type": "string"
        },
        "source_family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Family"
        },
        "imported_at": {
          "format": "date-time",
          "title": "Imported At",
          "type": "string"
        }
      },
      "required": [
        "provider_mode",
        "source_name"
      ],
      "title": "SourceLineage",
      "type": "object"
    }
  },
  "properties": {
    "provider": {
      "const": "aws",
      "default": "aws",
      "title": "Provider",
      "type": "string"
    },
    "account_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Account Id"
    },
    "region": {
      "default": "unknown",
      "title": "Region",
      "type": "string"
    },
    "resource_type": {
      "enum": [
        "ec2_instance",
        "ebs_volume"
      ],
      "title": "Resource Type",
      "type": "string"
    },
    "resource_id": {
      "title": "Resource Id",
      "type": "string"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "state": {
      "default": "unknown",
      "title": "State",
      "type": "string"
    },
    "tags": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Tags",
      "type": "object"
    },
    "discovered_at": {
      "format": "date-time",
      "title": "Discovered At",
      "type": "string"
    },
    "source_lineage": {
      "$ref": "#/$defs/SourceLineage"
    },
    "ec2": {
      "anyOf": [
        {
          "$ref": "#/$defs/EC2Details"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ebs": {
      "anyOf": [
        {
          "$ref": "#/$defs/EBSDetails"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metrics": {
      "additionalProperties": {
        "$ref": "#/$defs/MetricSummary"
      },
      "title": "Metrics",
      "type": "object"
    },
    "costs": {
      "$ref": "#/$defs/CostSummary"
    },
    "source_metadata": {
      "additionalProperties": true,
      "title": "Source Metadata",
      "type": "object"
    }
  },
  "required": [
    "resource_type",
    "resource_id",
    "source_lineage"
  ],
  "title": "CloudResource",
  "type": "object"
}